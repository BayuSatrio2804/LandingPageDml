{
  "name": "dml-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare-assets": "bun scripts/prepare-assets.ts",
    "prepare:cert-placeholders": "bun scripts/prepare-cert-placeholders.ts",
    "prepare-map": "bun scripts/prepare-map.ts",
    "prepare-models": "bun scripts/prepare-models.ts",
    "prepare-og-corporate": "bun scripts/prepare-og-corporate.tsx",
    "doctor": "react-doctor . -y --blocking warning --no-score",
    "doctor:design": "react-doctor design",
    "lighthouse": "lhci autorun",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run doctor && bun run lighthouse",
    "payload": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload",
    "generate:types": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload generate:types",
    "generate:importmap": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload generate:importmap",
    "seed": "bun build scripts/seed.ts --target=bun --outfile=.seed-bundle.js && PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts bun .seed-bundle.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.0",
    "@payloadcms/db-postgres": "^3.88",
    "@payloadcms/next": "^3.88",
    "@payloadcms/richtext-lexical": "^3.88",
    "@phosphor-icons/react": "^2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "geist": "^1.7.2",
    "gsap": "^3.13",
    "lenis": "^1.3",
    "next": "16.3.1",
    "payload": "^3.88",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@gltf-transform/cli": "4.4.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30",
    "react-doctor": "^0.9.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
