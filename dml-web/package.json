{
  "name": "dml-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "doctor": "react-doctor . -y --blocking warning --no-score",
    "doctor:design": "react-doctor design",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run doctor",
    "payload": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload",
    "generate:types": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload generate:types",
    "generate:importmap": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload generate:importmap"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.73",
    "@payloadcms/next": "^3.73",
    "@payloadcms/richtext-lexical": "^3.73",
    "@phosphor-icons/react": "^2",
    "geist": "^1.7.2",
    "gsap": "^3.13",
    "lenis": "^1.3",
    "next": "16.3.1",
    "payload": "^3.73",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30",
    "react-doctor": "^0.9.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
