# URL kanonis situs, dipakai untuk metadata SEO, JSON-LD, dan sitemap.
NEXT_PUBLIC_SITE_URL=https://dutabaharimenaraline.co.id
# Connection string Postgres untuk Payload. Cocokkan user/password/db dengan docker-compose.yml.
DATABASE_URI=postgres://dml:dml_dev_only@localhost:5432/dml
# Secret Payload untuk signing session/token. Ganti dengan string acak panjang, jangan pakai contoh ini.
PAYLOAD_SECRET=ganti-dengan-string-acak-panjang
# Token API Sketchfab, hanya dibutuhkan saat menjalankan bun run prepare-models.
# Ambil dari sketchfab.com/settings/password. Tidak dipakai saat build atau runtime.
SKETCHFAB_TOKEN=
# Jumlah proxy tepercaya di depan aplikasi ini. Menentukan entri
# x-forwarded-for mana yang dipakai sebagai kunci rate limit, dihitung dari
# kanan. Default 1 cocok untuk satu reverse proxy. Naikkan kalau ada CDN plus
# load balancer di depannya; salah setel ke angka terlalu besar membuat kunci
# jatuh ke nilai yang dikendalikan klien.
TRUSTED_PROXY_HOPS=1
# Kredensial admin pertama yang dibuat `bun run seed`. Dipakai juga oleh
# tests/e2e/global-setup.ts supaya spec admin-publish punya akun yang pasti
# ada. JANGAN memakai nilai contoh ini di produksi: seed berjalan saat setup
# container pertama, dan akun dengan sandi yang tertulis di repo publik sama
# saja dengan admin panel tanpa sandi.
SEED_ADMIN_EMAIL=admin@dutabaharimenaraline.co.id
SEED_ADMIN_PASSWORD=ganti-dengan-sandi-panjang-yang-acak
# Direktori tempat Payload menyimpan berkas upload. Di container, path ini
# WAJIB menunjuk volume persisten, kalau tidak seluruh gambar artikel hilang
# tiap redeploy. Kosongkan untuk memakai ./uploads saat pengembangan lokal.
PAYLOAD_UPLOAD_DIR=

# --- Khusus deploy Vercel: penyimpanan media di Cloudflare R2 ---
# Filesystem Vercel ephemeral, jadi upload admin WAJIB masuk ke object
# storage. Isi lima nilai ini untuk mengalihkan koleksi `media` dari disk
# lokal ke bucket R2. Kosongkan semuanya untuk memakai disk lokal (dev,
# Docker + volume). Kalau R2_BUCKET kosong, empat sisanya diabaikan.
R2_BUCKET=
# Endpoint S3 API akun R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Dari R2 > Manage API Tokens > Create API Token (izin Object Read & Write).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Domain publik bucket: r2.dev yang diaktifkan lewat "Public Development URL",
# atau custom domain. Tanpa trailing slash. Contoh: https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# --- Khusus docker-compose.prod.yml ---
# Compose membaca nilai-nilai ini dari .env di dml-web/. Jangan memakai
# kredensial pengembangan di sini.
POSTGRES_USER=dml
POSTGRES_PASSWORD=ganti-dengan-sandi-panjang-yang-acak
POSTGRES_DB=dml
# Di dalam compose produksi, host-nya nama service, bukan localhost:
# DATABASE_URI=postgres://dml:SANDI@postgres:5432/dml
