# URL kanonis situs, dipakai untuk metadata SEO, JSON-LD, dan sitemap.
NEXT_PUBLIC_SITE_URL=https://dutabaharimenaraline.co.id
# Connection string Postgres untuk Payload. Cocokkan user/password/db dengan docker-compose.yml.
DATABASE_URI=postgres://dml:dml_dev_only@localhost:5432/dml
# Secret Payload untuk signing session/token. Ganti dengan string acak panjang, jangan pakai contoh ini.
PAYLOAD_SECRET=ganti-dengan-string-acak-panjang
# Token API Sketchfab, hanya dibutuhkan saat menjalankan bun run prepare-models.
# Ambil dari sketchfab.com/settings/password. Tidak dipakai saat build atau runtime.
SKETCHFAB_TOKEN=
